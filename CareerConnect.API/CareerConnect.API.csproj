<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1701bc1f-294a-4f68-8472-a0a8621bc450</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Middleware\" />
    <Folder Include="Extensions\" />
    <Folder Include="wwwroot\resumes\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CareerConnect.Application\CareerConnect.Application.csproj" />
    <ProjectReference Include="..\CareerConnect.Infrastructure\CareerConnect.Infrastructure.csproj" />
    <ProjectReference Include="..\CareerConnect.Shared\CareerConnect.Shared.csproj" />
  </ItemGroup>

</Project>
